// Schema completo do domínio (Fase 1: modelagem + auth + multi-tenant + auditoria).
// Regras de isolamento e decisões em PLAN.md. A lógica de cada domínio entra na Fase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── RBAC / Tenant ─────────────────────────

enum Role {
  OPERADOR
  SUPERVISOR
  ADMINISTRADOR
}

enum EventStatus {
  ABERTO
  ENCERRADO
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  events Event[]
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  // Admin/supervisor logam por e-mail (senha global). Atendentes logam por CPF
  // (senha fica na vinculação com o evento — ver EventMembership). Ambos opcionais,
  // mas ao menos um identificador é obrigatório na aplicação.
  email        String?  @unique
  cpf          String?  @unique
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   EventMembership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
}

model Event {
  id                String      @id @default(uuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id])
  name              String
  adminPasswordHash String
  serviceFeeEnabled Boolean     @default(false)
  serviceFeePercent Decimal     @default(0) @db.Decimal(5, 2)
  status            EventStatus @default(ABERTO)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  memberships   EventMembership[]
  categories    Category[]
  products      Product[]
  ingredients   Ingredient[]
  cashRegisters CashRegister[]
  tabs          Tab[]
  sales         Sale[]
  courtesies    Courtesy[]
  losses        LossRecord[]
  auditLogs     AuditLog[]

  @@index([companyId])
}

model EventMembership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  role      Role
  // Credencial do atendente POR EVENTO (controlada pelo Admin):
  // senha, validade e ativo/inativo. Nulo para usuários com login global por e-mail.
  passwordHash String?
  expiresAt    DateTime?
  active       Boolean   @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────── Produtos / Estoque / Ficha técnica ─────────────────────────

model Category {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  name    String

  products Product[]

  @@index([eventId])
}

model Product {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String
  price      Decimal   @db.Decimal(10, 2)
  stock      Int       @default(0)
  minStock   Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  recipe    RecipeItem[]
  tabItems  TabItem[]
  saleItems SaleItem[]

  @@index([eventId])
}

model Ingredient {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id])
  name     String
  unit     String // ml, g, un
  stock    Decimal @default(0) @db.Decimal(12, 3)
  minStock Decimal @default(0) @db.Decimal(12, 3)

  recipeItems RecipeItem[]

  @@index([eventId])
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 3)

  @@unique([productId, ingredientId])
}

// ───────────────────────── Caixa ─────────────────────────

enum CashRegisterStatus {
  ABERTO
  FECHADO
}

model CashRegister {
  id            String             @id @default(uuid())
  eventId       String
  event         Event              @relation(fields: [eventId], references: [id])
  openedById    String
  openingAmount Decimal            @db.Decimal(10, 2)
  closingAmount Decimal?           @db.Decimal(10, 2)
  status        CashRegisterStatus @default(ABERTO)
  openedAt      DateTime           @default(now())
  closedAt      DateTime?

  movements CashMovement[]
  sales     Sale[]

  @@index([eventId])
}

enum CashMovementType {
  SANGRIA
  SUPRIMENTO
}

model CashMovement {
  id             String           @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  reason         String
  responsibleId  String
  createdAt      DateTime         @default(now())

  @@index([cashRegisterId])
}

// ───────────────────────── Comandas / Vendas / Pagamentos ─────────────────────────

enum TabStatus {
  ABERTA
  FECHADA
  CANCELADA
}

model Tab {
  id       String    @id @default(uuid())
  eventId  String
  event    Event     @relation(fields: [eventId], references: [id])
  code     String // valor do QR Code
  status   TabStatus @default(ABERTA)
  openedAt DateTime  @default(now())
  closedAt DateTime?

  items TabItem[]
  sales Sale[]

  @@unique([eventId, code])
  @@index([eventId])
}

model TabItem {
  id        String   @id @default(uuid())
  tabId     String
  tab       Tab      @relation(fields: [tabId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([tabId])
}

enum SaleStatus {
  CONCLUIDA
  CANCELADA
}

model Sale {
  id             String        @id @default(uuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id])
  clientId       String // UUID gerado no terminal → idempotência offline (ver PLAN ADR-04)
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  tabId          String?
  tab            Tab?          @relation(fields: [tabId], references: [id])
  operatorId     String
  machineId      String?
  subtotal       Decimal       @db.Decimal(10, 2)
  serviceFee     Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  status         SaleStatus    @default(CONCLUIDA)
  createdAt      DateTime      @default(now())

  items    SaleItem[]
  payments Payment[]
  refund   Refund?

  @@unique([eventId, clientId])
  @@index([eventId])
  @@index([operatorId])
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  isCourtesy Boolean @default(false)

  @@index([saleId])
}

enum PaymentMethod {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
  CORTESIA
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model Courtesy {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  saleId        String?
  beneficiary   String
  reason        String
  amount        Decimal  @db.Decimal(10, 2)
  responsibleId String
  createdAt     DateTime @default(now())

  @@index([eventId])
}

model Refund {
  id            String   @id @default(uuid())
  saleId        String   @unique
  sale          Sale     @relation(fields: [saleId], references: [id])
  reason        String
  amount        Decimal  @db.Decimal(10, 2)
  responsibleId String
  createdAt     DateTime @default(now())
}

// ───────────────────────── Perdas ─────────────────────────

enum LossType {
  QUEBRA
  VAZAMENTO
  CONSUMO_INTERNO
  VENCIDO
}

model LossRecord {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  productId     String?
  ingredientId  String?
  type          LossType
  quantity      Decimal  @db.Decimal(12, 3)
  reason        String
  responsibleId String
  createdAt     DateTime @default(now())

  @@index([eventId])
}

// ───────────────────────── Auditoria (append-only) ─────────────────────────
// Imutável: sem UPDATE/DELETE a nível de aplicação. Reforçado por trigger no banco
// (migration `audit_append_only`). Ver PLAN ADR-02.

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  machineId String?
  action    String
  entity    String?
  entityId  String?
  amount    Decimal? @db.Decimal(12, 2)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([action])
}
