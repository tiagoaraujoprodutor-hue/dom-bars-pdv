# ============================================================================
# Configuração de PRODUÇÃO (self-host). Copie para ".env" e preencha:
#   cd infra && cp .env.prod.example .env
# NUNCA commitar o .env preenchido (só este .example).
# ============================================================================

# ---- Banco (Postgres) — o compose monta o DATABASE_URL a partir daqui ----
POSTGRES_USER=pdv
POSTGRES_PASSWORD=TROQUE-por-uma-senha-forte
POSTGRES_DB=pdv

# ---- Auth (JWT) — GERE dois segredos LONGOS e ALEATÓRIOS (32+ caracteres) ----
# Dica p/ gerar: openssl rand -hex 32
JWT_SECRET=TROQUE-por-um-segredo-longo-e-aleatorio
JWT_REFRESH_SECRET=TROQUE-por-outro-segredo-longo-e-aleatorio
# Duração do token de acesso (opcional; padrão 12h).
JWT_ACCESS_TTL=12h

# ---- Painel web ----
# URL PÚBLICA da API que o NAVEGADOR vai acessar. É embutida no build do painel,
# então precisa estar correta ANTES do "up --build". Ex.: https://api.seudominio.com.br
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Rate limit (opcional) ----
THROTTLE_LIMIT=2000

# ---- PagBank PIX online (OPCIONAL — deixe desligado até homologar) ----
# Só ligue depois de validar em sandbox. Ligado, exige TOKEN + WEBHOOK_TOKEN + URL.
PAGBANK_ENABLED=false
PAGBANK_BASE_URL=https://api.pagseguro.com
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_TOKEN=
PAGBANK_NOTIFICATION_URL=
