  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.9.18",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
