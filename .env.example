# ---- API ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL ----
DATABASE_URL=postgresql://pdv:pdv@localhost:5432/pdv

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Fase 1) ----
JWT_SECRET=troque-este-segredo
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d

# ---- PagBank Orders API (PIX online) ----
# Desligado por padrão: nada muda até ligar E fornecer token/URL (guardrail no boot).
# Dev usa SANDBOX; produção usa https://api.pagseguro.com (valores no Coolify).
PAGBANK_ENABLED=false
PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_TOKEN=
# String aleatória forte sua — vai na querystring do webhook (?t=...).
PAGBANK_WEBHOOK_TOKEN=
# URL pública deste backend (dev: túnel ngrok; prod: domínio do Coolify).
PAGBANK_NOTIFICATION_URL=
PAGBANK_PIX_EXPIRATION_SECONDS=1800
